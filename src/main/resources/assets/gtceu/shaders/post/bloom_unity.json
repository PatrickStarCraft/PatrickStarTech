{
  "targets": {
    "gtceu:filter": {},
    "gtceu:swap_a2": {},
    "gtceu:swap_a4": {},
    "gtceu:swap_1": {},
    "gtceu:swap_2": {}
  },
  "passes": [
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "gtceu:program/filter_bloom_color",
      "inputs": [
        { "sampler_name": "Diffuse", "target": "gtceu:bloom_source" },
        { "sampler_name": "DiffuseDepth", "target": "gtceu:bloom_source", "use_depth_buffer": true },
        { "sampler_name": "MainDepth", "target": "minecraft:main", "use_depth_buffer": true }
      ],
      "output": "gtceu:filter",
      "uniforms": {
        "BloomDepth": [
          { "type": "float", "value": 0.05 },
          { "type": "float", "value": 512.0 }
        ]
      }
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:core/blit_screen",
      "inputs": [ { "sampler_name": "In", "target": "gtceu:filter" } ],
      "output": "gtceu:swap_a2"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "gtceu:program/down_sampling",
      "inputs": [ { "sampler_name": "Diffuse", "target": "gtceu:swap_a2", "bilinear": true } ],
      "output": "gtceu:swap_a4"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "gtceu:program/down_sampling",
      "inputs": [ { "sampler_name": "Diffuse", "target": "gtceu:swap_a4", "bilinear": true } ],
      "output": "gtceu:swap_1"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "gtceu:program/down_sampling",
      "inputs": [ { "sampler_name": "Diffuse", "target": "gtceu:swap_1", "bilinear": true } ],
      "output": "gtceu:swap_2"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "gtceu:program/up_sampling",
      "inputs": [
        { "sampler_name": "Diffuse", "target": "gtceu:swap_2", "bilinear": true },
        { "sampler_name": "DownTexture", "target": "gtceu:swap_a4", "bilinear": true }
      ],
      "output": "gtceu:swap_1"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "gtceu:program/up_sampling",
      "inputs": [
        { "sampler_name": "Diffuse", "target": "gtceu:swap_1", "bilinear": true },
        { "sampler_name": "DownTexture", "target": "gtceu:swap_a2", "bilinear": true }
      ],
      "output": "gtceu:swap_2"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "gtceu:program/up_sampling",
      "inputs": [
        { "sampler_name": "Diffuse", "target": "gtceu:swap_2", "bilinear": true },
        { "sampler_name": "DownTexture", "target": "gtceu:filter" }
      ],
      "output": "gtceu:swap_1"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "gtceu:program/unity_composite",
      "inputs": [
        { "sampler_name": "Diffuse", "target": "gtceu:swap_1", "bilinear": true },
        { "sampler_name": "Highlight", "target": "gtceu:filter" },
        { "sampler_name": "Main", "target": "minecraft:main" }
      ],
      "output": "gtceu:bloom_output",
      "uniforms": {
        "BloomSettings": [
          { "type": "float", "value": 1.7 },
          { "type": "float", "value": 0.1 },
          { "type": "float", "value": 0.5 },
          { "type": "float", "value": 0.2 }
        ]
      }
    }
  ]
}
